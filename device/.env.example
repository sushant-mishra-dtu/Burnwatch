# Copy settings from setup_iot.py / setup_device_iam.py; never commit device/.env.
IOT_ENDPOINT=example-ats.iot.ap-south-1.amazonaws.com
CAMERA_ID=rwa-gate-2
CLIENT_ID=burnwatch-rwa-gate-2
CERT_PATH=device/certs/rwa-gate-2/certificate.pem
KEY_PATH=device/certs/rwa-gate-2/private.key
CA_PATH=device/certs/AmazonRootCA1.pem
BUCKET=burnwatch-frames-123456789012-ap-south-1
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=YOUR_DEVICE_UPLOAD_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_DEVICE_UPLOAD_SECRET_ACCESS_KEY
